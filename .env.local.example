# Server-side key: used for Directions API (route optimization) and Geocoding API.
# Keep this secret — never expose it to the browser. In Google Cloud Console,
# restrict it by IP address (your server) and enable: Directions API, Geocoding API.
GOOGLE_MAPS_API_KEY=

# Client-side key: used only to load the Maps JavaScript API for rendering the map.
# Must be prefixed NEXT_PUBLIC_ to be available in the browser. Restrict it by
# HTTP referrer (your app's domain / localhost) and enable: Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Cloud project ID used for the Route Optimization API (fleet-wide
# auto-assign). Unlike the keys above, this API authenticates via OAuth2 /
# Application Default Credentials, not an API key:
#   - Locally: run `gcloud auth application-default login` once, and set this
#     to your project ID (gcloud config get-value project).
#   - In Cloud Run: not needed — the attached service account is used
#     automatically and the project is inferred from the environment.
GOOGLE_CLOUD_PROJECT=

# Fleet Engine (Driver SDK backend) — the "provider ID" is just a GCP project
# ID, but Fleet Engine's Delivery API requires the project to be explicitly
# allowlisted by Google (a sales/business gate, not something any amount of
# `gcloud services enable` or IAM configuration grants) — it is very likely a
# DIFFERENT project from GOOGLE_CLOUD_PROJECT above, which only needs the
# self-serve Route Optimization API.
FLEET_ENGINE_PROVIDER_ID=

# Optional: a dedicated backend service account (roles/fleetengine.deliveryAdmin
# on FLEET_ENGINE_PROVIDER_ID) to impersonate, for setups where the identity
# actually running this server doesn't hold Fleet Engine roles itself. If set,
# the calling identity just needs roles/iam.serviceAccountTokenCreator on this
# one SA — no key file, tokens auto-refresh. Leave unset if the ambient ADC
# identity already has fleetengine.deliveryAdmin directly.
#
# Also used (via the same impersonation) to mint the bearer tokens handed to
# the Android Driver SDK from app/api/fleet-engine/token — note this means
# those tokens carry full deliveryAdmin scope over every vehicle, not just
# the requesting one. A deliberate demo-grade trade-off; see that route's
# comments.
FLEET_ENGINE_BACKEND_SA=
