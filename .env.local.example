# Server-side key: used for Directions API (route optimization) and Geocoding API.
# Keep this secret — never expose it to the browser. In Google Cloud Console,
# restrict it by IP address (your server) and enable: Directions API, Geocoding API.
GOOGLE_MAPS_API_KEY=

# Client-side key: used only to load the Maps JavaScript API for rendering the map.
# Must be prefixed NEXT_PUBLIC_ to be available in the browser. Restrict it by
# HTTP referrer (your app's domain / localhost) and enable: Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Cloud project ID used for the Route Optimization API (fleet-wide
# auto-assign). Unlike the keys above, this API authenticates via OAuth2 /
# Application Default Credentials, not an API key:
#   - Locally: run `gcloud auth application-default login` once, and set this
#     to your project ID (gcloud config get-value project).
#   - In Cloud Run: not needed — the attached service account is used
#     automatically and the project is inferred from the environment.
GOOGLE_CLOUD_PROJECT=
