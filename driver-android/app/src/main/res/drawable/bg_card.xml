<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the web app's route card: rounded-lg white surface with a 1px grey-300 border
     (app/driver/page.js's `rounded-lg border border-neutral-300 bg-white p-5`). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
