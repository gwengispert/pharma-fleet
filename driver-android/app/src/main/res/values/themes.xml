<resources>
    <!-- No launcher icon is declared in AndroidManifest.xml yet — Android
         Studio will fall back to a default. Run Image Asset (right-click
         res/ > New > Image Asset) to generate a real one before shipping. -->
    <!-- Light-only, like the web app: Google blue + Google greys on white,
         Material 3 widgets (pill buttons, switches) and Roboto, Android's
         default typeface. -->
    <style name="Theme.PharmaFleetDriver" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/foreground</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Dark status/navigation bar icons on the white, edge-to-edge UI. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="materialButtonStyle">@style/Widget.PharmaFleet.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PharmaFleet.Button.Outlined</item>
    </style>

    <!-- Google-style buttons: pill shape, sentence case, medium weight. -->
    <style name="Widget.PharmaFleet.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Outlined: grey 300 outline with blue text, like the web's secondary actions. -->
    <style name="Widget.PharmaFleet.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/brand</item>
        <item name="iconTint">@color/brand</item>
    </style>
</resources>
