<?xml version="1.0" encoding="utf-8"?>
<!-- Header + map, with the actions in a bottom sheet over the map's bottom
     edge. Not driving: the sheet is fully open (and fixed) showing the
     buttons. Driving: it collapses to the ETA card with a drag handle, and
     sliding it up reveals the buttons again — like Google Maps navigation. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <!-- The map runs under the bottom sheet (which floats, inset from the
         sides); MapActivity lifts the Street View preview and map controls
         above the sheet's resting height. -->
    <LinearLayout
        android:id="@+id/mapContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/mapBackLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:text="← Back"
                android:textColor="@color/brand"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Map and full Street View occupy the same area; only one is visible
             at a time. The small Street View preview over the map opens the full
             one; the "Map" button over Street View goes back. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/mapContainer"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/streetViewContainer"
                android:name="com.google.android.gms.maps.SupportStreetViewPanoramaFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Live Street View preview of the current stop. Gestures are off;
                 the transparent overlay on top takes the tap. The label sits at
                 the top: the panorama's required Google attribution is at the
                 bottom. -->
            <FrameLayout
                android:id="@+id/streetViewThumb"
                android:layout_width="136dp"
                android:layout_height="100dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_thumb"
                android:elevation="6dp"
                android:padding="2dp">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/streetViewThumbPanorama"
                    android:name="com.google.android.gms.maps.SupportStreetViewPanoramaFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/streetViewThumbEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_variant"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="No Street View here"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="#8A202124"
                    android:drawablePadding="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Street View"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/streetViewThumbTouch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Open Street View"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Turn-by-turn header while driving, like the Navigation SDK:
                 the next maneuver (icon, distance, instruction) and a
                 secondary "Then …" row for the one after it. -->
            <LinearLayout
                android:id="@+id/navHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="8dp"
                android:background="@drawable/bg_nav_header"
                android:elevation="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:id="@+id/navManeuverIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Next maneuver"
                        android:src="@drawable/ic_maneuver_straight" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/navDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/navInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/nav_secondary"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Then"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/navThenIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Following maneuver"
                        android:src="@drawable/ic_maneuver_straight"
                        app:tint="@color/foreground" />

                    <TextView
                        android:id="@+id/navThenInstruction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/foreground"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shown while driving once the driver pans/zooms the map
                 (which pauses the follow camera); tapping resumes following.
                 Bottom margin is set in code to sit just above the sheet. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recenterButton"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Re-center"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:visibility="gone"
                app:backgroundTint="@color/surface"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart"
                app:iconTint="@color/brand" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToMapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:text="Map"
                android:visibility="gone"
                app:icon="@drawable/ic_map_pin"
                app:iconGravity="textStart" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_eta_card"
        android:elevation="8dp"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Slim handle: Material's default reserves a 48dp touch area plus
             padding, which left a big gap above the ETA. The whole sheet is
             draggable anyway. -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <!-- Trip summary while driving: time left, distance left and
             arrival time, plus speed / skip. Stays visible when the sheet
             is collapsed. -->
        <LinearLayout
            android:id="@+id/etaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/etaDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/eta_on_time"
                    android:textSize="30sp" />

                <!-- One line, shrinking to fit beside the speed / skip
                     buttons, so the collapsed card's height never changes. -->
                <TextView
                    android:id="@+id/etaDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <!-- Playback speed (cycles through the server's options) and
                 skip-to-destination, shared with the web driver view —
                 tucked away until the settings button reveals them. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/speedButton"
                android:visibility="gone"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:contentDescription="Playback speed"
                android:text="1×" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipButton"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="Skip"
                app:icon="@drawable/ic_skip"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveSettingsButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="Drive settings"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/text_secondary" />
        </LinearLayout>

        <!-- The stop being driven to / previewed, right above its actions,
             with arrows to preview the previous / next stop on the route. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prevStopButton"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Previous stop"
                app:icon="@drawable/ic_arrow_left"
                app:iconTint="@color/brand"
                app:strokeColor="@color/border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mapDestinationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/foreground"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/mapDestinationAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextStopButton"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Next stop"
                app:icon="@drawable/ic_arrow_right"
                app:iconTint="@color/brand"
                app:strokeColor="@color/border" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/driveActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startDrivingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Driving"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markDeliveredNextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mark delivered &amp; next stop"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
